{
  "name": "@clutchcode/acp",
  "version": "0.1.0",
  "description": "The Agent API's Agent Client Protocol (ACP) binding (PROJECT_SPEC.md §18.1/§20/§26): an ndjson-over-stdio ACP agent, built on the official @agentclientprotocol/sdk, wrapping @clutchcode/agent-api's Agent so any ACP client (Zed today; Neovim/Emacs later) can drive a run without a separate reimplementation of agent logic.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@clutchcode/agent-api": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Derric01/ClutchCode.git",
    "directory": "packages/acp"
  },
  "homepage": "https://github.com/Derric01/ClutchCode#readme",
  "bugs": {
    "url": "https://github.com/Derric01/ClutchCode/issues"
  }
}
